# ==============================================================================
# CONFIGURACIÓN DEL AGENTE LOGÍSTICO (PLANTILLA DE EJEMPLO)
# ==============================================================================
# IMPORTANTE: Copia este archivo como '.env' y asigna los IDs reales de tu entorno.
# NUNCA subas a Git tu archivo '.env' con datos reales o claves de acceso.

# 1. Conexión al servidor MCP Toolbox (ejecutándose en local o Cloud Run)
TOOLBOX_URL=http://localhost:5001/mcp

# 2. Proyecto de Google Cloud BigQuery donde residen las tablas
BIGQUERY_PROJECT=tu-proyecto-bigquery-sbx

# 3. Configuración del Modelo de IA (Gemini)
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLOUD_LOCATION=us-central1

# 4. Proyecto de Google Cloud Vertex AI (si se usan credenciales corporativas ADC)
VERTEXAI_PROJECT=tu-proyecto-vertexai-dev
USE_VERTEXAI=true

# 5. Clave de API alternativa (solo para desarrollo local en Google AI Studio)
# GEMINI_API_KEY=tu_api_key_aqui
