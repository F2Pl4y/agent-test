# ==============================================================================
# CONFIGURACIÓN DEL AGENTE LOGÍSTICO TOTTUS (BACKEND)
# ==============================================================================

# 1. Conexión al servidor MCP Toolbox (ejecutándose en local o Cloud Run)
TOOLBOX_URL=http://localhost:5001/mcp

# 2. Proyecto de BigQuery con las tablas de datos logísticos
BIGQUERY_PROJECT=tot-corp-plo-sbx

# 3. Configuración del Modelo de IA (Gemini 2.5 Flash / Pro)
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLOUD_LOCATION=us-central1

# Si se usa Vertex AI corporativo con credenciales ADC de gcloud:
VERTEXAI_PROJECT=tot-bi-corp-arq-dev
USE_VERTEXAI=true

# Si se usa API Key directa de Google AI Studio (opcional / fallback para pruebas):
# GEMINI_API_KEY=AIzaSy...
